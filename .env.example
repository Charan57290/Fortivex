# ==========================================
# VoxSales AI - Environment Configuration
# ==========================================

# Server
NODE_ENV=development
PORT=5000
FRONTEND_URL=http://localhost:5173

# Database (PostgreSQL with pgvector extension)
# When omitted or unreachable, backend uses local-json-store for zero-config evaluation
DATABASE_URL="postgresql://voxsales:voxsales_pass@localhost:5432/voxsales_ai?schema=public"
STORAGE_MODE=auto # auto | postgres | local

# Redis (optional for MVP; used for distributed session/cache in production)
REDIS_URL="redis://localhost:6379"

# Security & Auth
JWT_SECRET="replace-with-a-strong-random-32-char-secret"
JWT_EXPIRES_IN="7d"

# Google Gemini AI (leave blank to evaluate in Demo Mode)
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-3.8-flash"
GEMINI_EMBEDDING_MODEL="text-embedding-004"

# File Uploads
MAX_UPLOAD_MB=10
