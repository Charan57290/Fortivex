// VoxSales AI - PostgreSQL + pgvector Prisma Schema

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [vector]
}

enum Role {
  ADMIN
  SALES_MANAGER
  SALES_AGENT
}

enum LeadClassification {
  HOT
  WARM
  COLD
}

enum PipelineStage {
  NEW
  CONTACTED
  QUALIFIED
  PROPOSAL
  NEGOTIATION
  WON
  LOST
}

enum ConversationStatus {
  IDLE
  CONNECTING
  LISTENING
  PROCESSING
  SPEAKING
  INTERRUPTED
  COMPLETED
  FAILED
}

enum MessageSender {
  CUSTOMER
  AI_AGENT
  SYSTEM
}

enum SentimentCategory {
  POSITIVE
  NEUTRAL
  NEGATIVE
}

enum DocumentStatus {
  PENDING
  PROCESSING
  INDEXED
  FAILED
}

enum AppointmentType {
  PRODUCT_DEMO
  SALES_CONSULTATION
  FOLLOW_UP_CALL
  TECHNICAL_DISCUSSION
}

enum AppointmentStatus {
  SCHEDULED
  CONFIRMED
  RESCHEDULED
  CANCELLED
  COMPLETED
}

enum TaskStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum HandoffStatus {
  PENDING
  ASSIGNED
  IN_PROGRESS
  RESOLVED
  DISMISSED
}

enum ToolExecutionStatus {
  SUCCESS
  FAILED
  BLOCKED
}

model Organization {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  industry  String?
  plan      String   @default("PRO")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users               User[]
  agentConfigurations AgentConfiguration[]
  companies           Company[]
  customers           Customer[]
  leads               Lead[]
  conversations       Conversation[]
  knowledgeDocuments  KnowledgeDocument[]
  knowledgeChunks     KnowledgeChunk[]
  appointments        Appointment[]
  followUpTasks       FollowUpTask[]
  salesActivities     SalesActivity[]
  humanHandoffs       HumanHandoff[]
  auditLogs           AuditLog[]
}

model User {
  id             String   @id @default(cuid())
  organizationId String
  email          String   @unique
  passwordHash   String
  fullName       String
  role           Role     @default(SALES_AGENT)
  avatarUrl      String?
  isActive       Boolean  @default(true)
  lastLoginAt    DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization       Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  assignedLeads      Lead[]              @relation("AssignedRep")
  appointments       Appointment[]       @relation("RepAppointments")
  followUpTasks      FollowUpTask[]
  salesActivities    SalesActivity[]
  assignedHandoffs   HumanHandoff[]      @relation("HandoffAssignee")
  uploadedDocuments  KnowledgeDocument[]
  auditLogs          AuditLog[]

  @@index([organizationId])
}

model AgentConfiguration {
  id                     String   @id @default(cuid())
  organizationId         String   @unique
  agentName              String   @default("Aria")
  companyName            String   @default("FlowStack SaaS")
  personality            String   @default("Consultative, empathetic, knowledgeable, concise, and solution-oriented.")
  greetingMessage        String   @default("Hello! Welcome to FlowStack. I'm Aria, your AI sales specialist. How can I help your team streamline project management today?")
  salesTone              String   @default("Professional & Consultative")
  supportedLanguages     String[] @default(["en-IN", "hi-IN", "te-IN"])
  productSummary         String   @default("FlowStack is an enterprise project management SaaS platform with Kanban, Gantt, Sprint Planning, Time Tracking, and AI Workflow Automation.")
  businessHours          String   @default("Mon-Fri 09:00 AM - 07:00 PM IST")
  appointmentDurationMin Int      @default(30)
  hotThreshold           Int      @default(75)
  warmThreshold          Int      @default(40)
  escalationRules        String   @default("Escalate immediately if customer explicitly requests a human, expresses high frustration, or asks for custom enterprise legal/SLA terms.")
  requireConsentForAudio Boolean  @default(true)
  retentionDays          Int      @default(90)
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

model Company {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  industry       String?
  sizeRange      String?
  employeeCount  Int?
  website        String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customers    Customer[]
  leads        Lead[]

  @@unique([organizationId, name])
  @@index([organizationId])
}

model Customer {
  id              String   @id @default(cuid())
  organizationId  String
  companyId       String?
  fullName        String
  email           String?
  phone           String?
  preferredLang   String   @default("en-IN")
  jobTitle        String?
  notes           String?
  consentRecorded Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  organization    Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  company         Company?        @relation(fields: [companyId], references: [id], onDelete: SetNull)
  leads           Lead[]
  conversations   Conversation[]
  appointments    Appointment[]
  followUpTasks   FollowUpTask[]
  salesActivities SalesActivity[]
  humanHandoffs   HumanHandoff[]

  @@index([organizationId])
  @@index([email])
  @@index([phone])
}

model Lead {
  id                    String             @id @default(cuid())
  organizationId        String
  customerId            String
  companyId             String?
  assignedToId          String?
  title                 String             @default("New Software Inquiry")
  industry              String?
  companySize           Int?
  budgetText            String?
  budgetMonthlyInr      Int?
  requirements          String?
  productInterest       String?
  recommendedPlan       String?
  leadSource            String             @default("AI Voice Agent")
  purchasingTimeline    String?
  decisionAuthority     String?
  score                 Int                @default(0)
  scoreBreakdown        Json?
  classification        LeadClassification @default(COLD)
  stage                 PipelineStage      @default(NEW)
  sentiment             SentimentCategory  @default(NEUTRAL)
  isDemo                Boolean            @default(false)
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt

  organization    Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customer        Customer        @relation(fields: [customerId], references: [id], onDelete: Cascade)
  company         Company?        @relation(fields: [companyId], references: [id], onDelete: SetNull)
  assignedTo      User?           @relation("AssignedRep", fields: [assignedToId], references: [id], onDelete: SetNull)
  conversations   Conversation[]
  appointments    Appointment[]
  followUpTasks   FollowUpTask[]
  salesActivities SalesActivity[]

  @@index([organizationId])
  @@index([classification])
  @@index([stage])
  @@index([customerId])
}

model Conversation {
  id              String             @id @default(cuid())
  organizationId  String
  customerId      String?
  leadId          String?
  language        String             @default("en-IN")
  status          ConversationStatus @default(IDLE)
  mode            String             @default("LIVE") // LIVE | DEMO
  startedAt       DateTime           @default(now())
  endedAt         DateTime?
  durationSeconds Int                @default(0)
  audioConsent    Boolean            @default(false)
  sessionMemory   Json?
  isDemo          Boolean            @default(false)
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  organization      Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customer          Customer?            @relation(fields: [customerId], references: [id], onDelete: SetNull)
  lead              Lead?                @relation(fields: [leadId], references: [id], onDelete: SetNull)
  messages          Message[]
  callSummary       CallSummary?
  sentimentAnalysis SentimentAnalysis?
  toolExecutions    AgentToolExecution[]
  humanHandoffs     HumanHandoff[]

  @@index([organizationId])
  @@index([customerId])
  @@index([status])
}

model Message {
  id             String        @id @default(cuid())
  conversationId String
  sender         MessageSender
  content        String
  language       String?
  sources        Json?
  metadata       Json?
  createdAt      DateTime      @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
}

model CallSummary {
  id                  String   @id @default(cuid())
  conversationId      String   @unique
  customerOverview    String
  mainRequirements    String[]
  productsDiscussed   String[]
  budgetInfo          String?
  purchaseIntent      String
  objections          String[]
  sentiment           SentimentCategory
  leadScore           Int
  qualificationStatus LeadClassification
  appointmentDetails  String?
  followUpActions     String[]
  recommendedNextStep String
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
}

model SentimentAnalysis {
  id                    String            @id @default(cuid())
  conversationId        String            @unique
  category              SentimentCategory
  score                 Float             // -1.0 to 1.0 or 0 to 100
  frustrationDetected   Boolean           @default(false)
  hesitationDetected    Boolean           @default(false)
  buyingSignals         String[]
  keyPhrases            String[]
  concerns              String[]
  interestLevel         String            @default("Medium")
  urgency               String            @default("Medium")
  satisfaction          String            @default("Neutral")
  recommendedNextAction String
  explanation           String
  isAiGenerated         Boolean           @default(true)
  createdAt             DateTime          @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
}

model KnowledgeDocument {
  id             String         @id @default(cuid())
  organizationId String
  uploadedById   String?
  title          String
  fileName       String
  fileType       String         // PDF | TXT
  fileSizeBytes  Int
  status         DocumentStatus @default(PENDING)
  chunkCount     Int            @default(0)
  errorMessage   String?
  isDemo         Boolean        @default(false)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  uploadedBy   User?            @relation(fields: [uploadedById], references: [id], onDelete: SetNull)
  chunks       KnowledgeChunk[]

  @@index([organizationId])
  @@index([status])
}

model KnowledgeChunk {
  id             String                       @id @default(cuid())
  organizationId String
  documentId     String
  chunkIndex     Int
  content        String
  tokenCount     Int                          @default(0)
  metadata       Json?
  embedding      Unsupported("vector(768)")?
  createdAt      DateTime                     @default(now())

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  document     KnowledgeDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([documentId])
}

model Appointment {
  id             String            @id @default(cuid())
  organizationId String
  customerId     String
  leadId         String?
  assignedToId   String?
  title          String
  type           AppointmentType   @default(PRODUCT_DEMO)
  status         AppointmentStatus @default(SCHEDULED)
  startTime      DateTime
  endTime        DateTime
  notes          String?
  meetingLink    String?
  isDemo         Boolean           @default(false)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customer     Customer     @relation(fields: [customerId], references: [id], onDelete: Cascade)
  lead         Lead?        @relation(fields: [leadId], references: [id], onDelete: SetNull)
  assignedTo   User?        @relation("RepAppointments", fields: [assignedToId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([startTime, endTime])
  @@index([customerId])
}

model FollowUpTask {
  id             String     @id @default(cuid())
  organizationId String
  customerId     String?
  leadId         String?
  assignedToId   String?
  title          String
  description    String?
  dueDate        DateTime
  status         TaskStatus @default(PENDING)
  priority       String     @default("MEDIUM")
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customer     Customer?    @relation(fields: [customerId], references: [id], onDelete: SetNull)
  lead         Lead?        @relation(fields: [leadId], references: [id], onDelete: SetNull)
  assignedTo   User?        @relation(fields: [assignedToId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([status])
}

model SalesActivity {
  id             String   @id @default(cuid())
  organizationId String
  customerId     String?
  leadId         String?
  userId         String?
  activityType   String   // CALL_STARTED | CALL_COMPLETED | STAGE_CHANGED | APPOINTMENT_BOOKED | NOTE_ADDED | HANDOFF_CREATED
  title          String
  description    String?
  metadata       Json?
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customer     Customer?    @relation(fields: [customerId], references: [id], onDelete: SetNull)
  lead         Lead?        @relation(fields: [leadId], references: [id], onDelete: SetNull)
  user         User?        @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([createdAt])
}

model AgentToolExecution {
  id             String              @id @default(cuid())
  conversationId String
  toolName       String
  inputParams    Json
  status         ToolExecutionStatus
  result         Json?
  errorDetails   String?
  durationMs     Int                 @default(0)
  executedAt     DateTime            @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@index([toolName])
}

model HumanHandoff {
  id             String        @id @default(cuid())
  organizationId String
  conversationId String
  customerId     String?
  assignedToId   String?
  reason         String
  summary        String?
  status         HandoffStatus @default(PENDING)
  priority       String        @default("HIGH")
  notes          String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  customer     Customer?    @relation(fields: [customerId], references: [id], onDelete: SetNull)
  assignedTo   User?        @relation("HandoffAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([status])
}

model AuditLog {
  id             String   @id @default(cuid())
  organizationId String
  userId         String?
  action         String
  resource       String
  resourceId     String?
  details        Json?
  ipAddress      String?
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User?        @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([createdAt])
}
